{
  "manifest_version": 3,
  "name": "Japanese Live Caption Translator",
  "version": "3.6.0",
  "description": "Bilingual Japanese–Traditional Chinese captions and page translation for online video and live audio.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "nativeMessaging",
    "activeTab",
    "tabs",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://cdn-lfs-us-1.hf.co/*",
    "https://cdn-lfs.huggingface.co/*",
    "https://huggingface.co/*",
    "https://api.mymemory.translated.net/*",
    "https://translate.googleapis.com/*",
    "https://integrate.api.nvidia.com/*",
    "https://openrouter.ai/*"
  ],
  "action": {
    "default_title": "日文直播翻譯助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "caption-window.js",
        "content.js"
      ],
      "css": [
        "content.css",
        "caption-window.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "caption-window.js",
        "x-content.js"
      ],
      "css": [
        "x-content.css",
        "caption-window.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
