{
  "manifest_version": 3,
  "name": "日文直播翻譯助手",
  "version": "2.1.0",
  "description": "YouTube 與 X Spaces 日文語音字幕、貼文翻譯，以及親切可愛的中文轉日文留言草稿。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "tabCapture",
    "offscreen"
  ],
  "host_permissions": [
    "https://openrouter.ai/*",
    "https://integrate.api.nvidia.com/*"
  ],
  "action": {
    "default_title": "日文直播翻譯助手",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*"
      ],
      "js": [
        "x-content.js"
      ],
      "css": [
        "x-content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
